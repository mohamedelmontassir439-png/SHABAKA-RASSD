# ============================================================
# ATLAS PRO — Variables d'environnement
# ============================================================
# Copie ce fichier vers .env et remplis les valeurs.
# NE COMMITE JAMAIS le fichier .env dans Git.
#
# Pour générer SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# --- OBLIGATOIRES (l'app ne démarre pas sans ça) ---
SECRET_KEY=CHANGE_ME_generer_avec_secrets.token_hex_32
ADMIN_PASS=CHANGE_ME_mot_de_passe_admin_fort_au_moins_16_chars

# --- Base de données ---
DB_PATH=data/atlas.db

# --- URL publique du site ---
SITE_URL=https://marocentrepreneuriat.com

# --- Notifications Telegram ---
# Crée un bot avec @BotFather sur Telegram, puis ajoute le token ici
TELEGRAM_BOT=
# Ton chat ID personnel (pour recevoir les alertes admin)
ADMIN_CHAT_ID=

# --- Notifications Email (Brevo/Sendinblue) ---
# https://www.brevo.com (300 emails/jour gratuit)
BREVO_API_KEY=
FROM_EMAIL=alerts@tondomaine.ma

# --- Notifications Email (Gmail fallback) ---
# App password uniquement, pas ton mot de passe Gmail normal
GMAIL_USER=
GMAIL_PASS=

# --- Scraping ---
# Intervalle entre les scans (en minutes)
SCAN_INTERVAL_MIN=60

# --- Debug (NE JAMAIS METTRE TRUE EN PRODUCTION) ---
DEBUG=false

# --- WhatsApp (nécessite le service séparé whatsapp_service/, voir TROUBLESHOOTING.md #8) ---
# Sur Railway: URL interne de la 2e service (ex: http://whatsapp.railway.internal:3001)
WA_SERVICE_URL=http://localhost:3001
# Doit être identique à WA_SECRET défini sur le service whatsapp_service
WA_SECRET=CHANGE_ME_secret_different_du_SECRET_KEY

# --- Global Marches (appels d'offres privés — global-marches.com) ---
# Identifiants de ton compte abonné (jamais en clair ailleurs que dans .env / Railway vars)
GM_USERNAME=
GM_PASSWORD=
GM_SCAN_INTERVAL_MIN=60

# ── WhatsApp via Twilio (résumé quotidien) ──────────────────────
# Console Twilio > Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Test: numéro Sandbox +14155238886 — Production: votre numéro approuvé par Meta
TWILIO_WHATSAPP_FROM=+14155238886
# Modèle approuvé (catégorie UTILITY) pour le résumé — vide = texte libre (Sandbox)
TWILIO_CONTENT_SID=
# Modèle d'authentification pour le code de vérification — vide = texte libre (Sandbox)
TWILIO_OTP_CONTENT_SID=
# Heure d'envoi du résumé (heure du Maroc)
WA_DIGEST_HOUR=9

# ── Annuaire d'entreprises : API Google Places ──────────────────
# Seule voie de collecte qui fonctionne sur le serveur : l'autre moteur
# pilote un navigateur, que le serveur n'embarque pas. Elle sert à deux
# choses — remplir l'annuaire par secteur et ville, et retrouver le contact
# des gagnants de marchés par leur nom, les avis d'attribution n'en
# publiant aucun.
# console.cloud.google.com > API Places (New) activée > Identifiants > Clé API
# Pensez à restreindre la clé à l'API Places et à définir un plafond.
GOOGLE_PLACES_API_KEY=
# Nombre de fiches par requête (secteur × ville) et pause entre appels
PLACES_MAX_PER_QUERY=60
PLACES_DELAY_MS=400
